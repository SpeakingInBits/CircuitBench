{
  "name": "circuit-bench",
  "displayName": "Circuit Bench",
  "description": "Build circuits and test code on simulated microcontroller boards. Runs CircuitPython for the Adafruit Metro M0 Express.",
  "keywords": ["circuitpython", "adafruit", "simulator", "breadboard", "circuit"],
  "version": "0.1.0",
  "publisher": "SpeakingInBits",
  "icon": "images/icon.png",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SpeakingInBits/CircuitBench" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Education", "Other"],
  "main": "./extension.cjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/circuit.test.js test/checks.test.js test/editing.test.js test/console.test.js test/traceback.test.js test/layout3d.test.js test/models3d.test.js test/readouts.test.js test/diagram.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "assets": "node scripts/copy-assets.js"
  },
  "activationEvents": ["workspaceContains:**/circuit.json"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "circuitBench.diagram",
        "displayName": "Circuit Diagram",
        "selector": [{ "filenamePattern": "circuit.json" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "circuitBench.open", "title": "Open Circuit Simulator", "category": "Circuit Bench", "icon": "$(circuit-board)" },
      { "command": "circuitBench.diagram", "title": "Show Circuit Diagram", "category": "Circuit Bench" },
      { "command": "circuitBench.run", "title": "Run on Simulator", "category": "Circuit Bench", "icon": "$(play)" },
      { "command": "circuitBench.stop", "title": "Stop Simulator", "category": "Circuit Bench", "icon": "$(debug-stop)" },
      { "command": "circuitBench.newProject", "title": "New Project from Example", "category": "Circuit Bench" },
      { "command": "circuitBench.addLibrary", "title": "Add Library to Project", "category": "Circuit Bench" },
      { "command": "circuitBench.setupEditor", "title": "Set Up CircuitPython Autocomplete", "category": "Circuit Bench" },
      { "command": "circuitBench.copyToBoard", "title": "Copy Project to CIRCUITPY Drive", "category": "Circuit Bench" },
      { "command": "circuitBench.export", "title": "Export Project", "category": "Circuit Bench" },
      { "command": "circuitBench.importPackage", "title": "Import Project Package", "category": "Circuit Bench" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "circuitBench", "title": "Circuit Bench", "icon": "$(circuit-board)" }
      ]
    },
    "views": {
      "circuitBench": [
        { "id": "circuitBench.start", "name": "Start", "icon": "$(circuit-board)" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "circuitBench.start",
        "contents": "Build a circuit and test your CircuitPython code on a simulated Metro M0 Express.\n[Open Circuit Simulator](command:circuitBench.open)\n[Run My Code](command:circuitBench.run)\nRun My Code runs code.py, or the Python file you have open.\nStarting a new project?\n[New Project from Example](command:circuitBench.newProject)\n[Import Project Package](command:circuitBench.importPackage)\nMore tools:\n[Set Up Autocomplete](command:circuitBench.setupEditor)\n[Export Project](command:circuitBench.export)"
      }
    ],
    "keybindings": [
      { "command": "circuitBench.run", "key": "f5", "when": "activeWebviewPanelId == 'circuitBench'" },
      { "command": "circuitBench.stop", "key": "shift+f5", "when": "activeWebviewPanelId == 'circuitBench'" }
    ],
    "menus": {
      "editor/title": [
        { "command": "circuitBench.open", "when": "resourceLangId == python || resourceFilename == circuit.json", "group": "navigation" }
      ],
      "editor/title/run": [
        { "command": "circuitBench.run", "when": "resourceLangId == python", "group": "navigation" }
      ]
    }
  }
}
