{
  "name": "circuit-bench",
  "displayName": "Circuit Bench",
  "description": "Build circuits and test code on simulated microcontroller boards. Runs CircuitPython for the Adafruit Metro M0 Express.",
  "keywords": ["circuitpython", "adafruit", "simulator", "breadboard", "circuit"],
  "version": "0.1.0",
  "publisher": "speakinginbits",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SpeakingInBits/CircuitBench" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Education", "Other"],
  "main": "./extension.cjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/circuit.test.js test/checks.test.js test/editing.test.js test/console.test.js test/layout3d.test.js test/diagram.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "assets": "node scripts/copy-assets.js"
  },
  "activationEvents": ["workspaceContains:**/circuit.json"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "circuitBench.diagram",
        "displayName": "Circuit Diagram",
        "selector": [{ "filenamePattern": "circuit.json" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "circuitBench.open", "title": "Open Circuit Simulator", "category": "Circuit Bench" },
      { "command": "circuitBench.diagram", "title": "Show Circuit Diagram", "category": "Circuit Bench" },
      { "command": "circuitBench.run", "title": "Run on Simulator", "category": "Circuit Bench", "icon": "$(play)" },
      { "command": "circuitBench.stop", "title": "Stop Simulator", "category": "Circuit Bench", "icon": "$(debug-stop)" },
      { "command": "circuitBench.newProject", "title": "New Project from Example", "category": "Circuit Bench" },
      { "command": "circuitBench.addLibrary", "title": "Add Library to Project", "category": "Circuit Bench" },
      { "command": "circuitBench.setupEditor", "title": "Set Up CircuitPython Autocomplete", "category": "Circuit Bench" },
      { "command": "circuitBench.copyToBoard", "title": "Copy Project to CIRCUITPY Drive", "category": "Circuit Bench" },
      { "command": "circuitBench.export", "title": "Export Project", "category": "Circuit Bench" },
      { "command": "circuitBench.importPackage", "title": "Import Project Package", "category": "Circuit Bench" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "circuitBench.run", "when": "resourceLangId == python", "group": "navigation" }
      ]
    }
  }
}
